+use std::sync::Arc;
+use std::time::Duration;
+
+use anyhow::{Result, bail, ensure};
+use surrealdb_types::{Kind, Value, Variables};
+
+use super::Datastore;
+use crate::catalog::providers::{DatabaseProvider, NamespaceProvider, TableProvider};
+use crate::dbs::{Capabilities, Session};
+use crate::kvs::{LockType, Transaction, TransactionType};
+use crate::val::TableName;
+
+/// One required existing field; see AGENTS.md for the spike boundary.
+#[derive(Clone, Debug)]
+pub struct ExistingField {
+	/// Existing table identifier.
+	pub table: String,
+	/// Existing field identifier.
+	pub field: String,
+	/// Expected database field kind.
+	pub kind: Kind,
+	/// Expected flexible-field setting.
+	pub flexible: bool,
+	/// Expected readonly-field setting.
+	pub readonly: bool,
+}
+
+/// Fixed owner and required-schema admission; this does not open a store.
+#[derive(Clone, Debug)]
+pub struct ExistingAdmission {
+	/// Existing namespace.
+	pub namespace: String,
+	/// Existing database.
+	pub database: String,
+	/// Table containing the retained owner row.
+	pub owner_table: String,
+	/// String identity field on that row.
+	pub identity_field: String,
+	/// Exact retained public identity.
+	pub identity: String,
+	/// Stored string owner field.
+	pub owner_field: String,
+	/// Actual DID derived from the already loaded key.
+	pub owner: String,
+	/// Required existing field definitions.
+	pub fields: Vec<ExistingField>,
+}
+
+fn identifier(value: &str) -> bool {
+	let mut bytes = value.bytes();
+	!value.is_empty()
+		&& value.len() <= 64
+		&& bytes.next().is_some_and(|b| b.is_ascii_alphabetic() || b == b'_')
+		&& bytes.all(|b| b.is_ascii_alphanumeric() || b == b'_')
+}
+
+impl ExistingAdmission {
+	fn validate(&self) -> Result<()> {
+		ensure!(
+			[&self.namespace, &self.database, &self.owner_table, &self.identity_field, &self.owner_field]
+				.into_iter().all(|name| identifier(name))
+				&& !self.identity.is_empty() && self.identity.len() <= 512
+				&& !self.owner.is_empty() && self.owner.len() <= 512
+				&& !self.fields.is_empty() && self.fields.len() <= 256
+				&& self.fields.iter().all(|field| identifier(&field.table) && identifier(&field.field)),
+			"existing_admission_spec_refused"
+		);
+		for name in [&self.identity_field, &self.owner_field] {
+			ensure!(self.fields.iter().any(|field| field.table == self.owner_table
+				&& &field.field == name && field.kind == Kind::String
+				&& !field.flexible), "existing_owner_schema_spec_refused");
+		}
+		Ok(())
+	}
+}
+
+impl Datastore {
+	/// Validate a guarded existing datastore before bootstrap; see AGENTS.md.
+	pub async fn admit_existing(mut self, expected: &ExistingAdmission) -> Result<Self> {
+		expected.validate()?;
+		let capabilities = self.capabilities.clone();
+		self.capabilities = Arc::new(Capabilities::none());
+		let tx = self.transaction(TransactionType::Read, LockType::Optimistic).await?
+			.enclose();
+		let result = tokio::time::timeout(Duration::from_secs(5),
+			self.check_existing_admission(expected, tx.clone())).await;
+		let cancelled = tx.cancel().await;
+		self.capabilities = capabilities;
+		match result {
+			Ok(Ok(())) => {}
+			Ok(Err(_)) => bail!("existing_admission_refused"),
+			Err(_) => bail!("existing_admission_timeout"),
+		}
+		cancelled.map_err(|_| anyhow::anyhow!("existing_admission_cancel_refused"))?;
+		Ok(self)
+	}
+
+	async fn check_existing_admission(
+		&self,
+		expected: &ExistingAdmission,
+		tx: Arc<Transaction>,
+	) -> Result<()> {
+		let version = tx.get(&crate::key::version::new(), None).await?
+			.ok_or_else(|| anyhow::anyhow!("existing_version_missing"))?;
+		ensure!(version.is_latest(), "existing_version_incompatible");
+		let namespace = tx.get_ns_by_name(&expected.namespace).await?
+			.ok_or_else(|| anyhow::anyhow!("existing_namespace_missing"))?;
+		let database = tx.get_db_by_name(&expected.namespace, &expected.database).await?
+			.ok_or_else(|| anyhow::anyhow!("existing_database_missing"))?;
+		for field in &expected.fields {
+			let table = TableName::from(field.table.as_str());
+			tx.get_tb_by_name(&expected.namespace, &expected.database, &table).await?
+				.ok_or_else(|| anyhow::anyhow!("existing_table_missing"))?;
+			let stored = tx.get_tb_field(namespace.namespace_id, database.database_id,
+				&table, &field.field).await?
+				.ok_or_else(|| anyhow::anyhow!("existing_field_missing"))?;
+			let kind: crate::expr::Kind = field.kind.clone().into();
+			ensure!(stored.field_kind.as_ref() == Some(&kind)
+				&& stored.flexible == field.flexible && stored.readonly == field.readonly
+				&& stored.computed.is_none(), "existing_field_incompatible");
+		}
+		let sql = format!(
+			"SELECT VALUE {} FROM {} WHERE {} = $retained_identity LIMIT 2 TIMEOUT 5s",
+			expected.owner_field, expected.owner_table, expected.identity_field
+		);
+		let mut variables = Variables::new();
+		variables.insert("retained_identity", expected.identity.clone());
+		let session = Session::owner().with_ns(&expected.namespace).with_db(&expected.database);
+		let mut results = self.execute_with_transaction(&sql, &session, Some(variables), tx).await?;
+		ensure!(results.len() == 1, "existing_owner_result_refused");
+		let result = results.pop().ok_or_else(|| anyhow::anyhow!("existing_owner_result_refused"))?;
+		let Value::Array(rows) = result.output()? else { bail!("existing_owner_result_refused") };
+		ensure!(rows.len() == 1, "existing_owner_cardinality_refused");
+		ensure!(matches!(rows.first(), Some(Value::String(owner)) if owner == &expected.owner),
+			"existing_owner_mismatch");
+		Ok(())
+	}
+}
