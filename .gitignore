# Build artifacts
/target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Runtime data
data/
coverage/

# Environment
.env
.env.*

# Claude/OMC state
.omc/
.claude/worktrees/

# Built sample hexon packages (regenerate via `cargo run -p fe-hexon --example build_sample_hexons`)
sample-hexons/dist/

# Local tooling fetched for e2e verification (BI egress A22) - never committed.
# NOTE: `/tools/*` (not `/tools/`) - a bare directory pattern makes git prune
# the whole subtree during the ignore walk, so a `!` exception for anything
# inside it never gets evaluated (verified with `git check-ignore -v`); the
# glob-of-immediate-children form ignores each top-level entry individually
# instead, so the negation below actually takes effect.
/tools/*
# ...except our own authored QA scripts (tools/qa/AGENTS.md) - these ARE tracked
!/tools/qa/
# ...and the extension authoring CLI + guest SDK (extension_platform E12)
!/tools/fe-ext/

# Agent-QA staged builds + isolated run dirs (tools/qa/stage.ps1, launch.ps1) -
# ephemeral, machine-local, can be large (a staged exe per commit)
.qa/
# QA pass screenshots (fe-qa-pass skill) - verdict.md + findings.jsonl are tracked, PNGs are not
/qa/passes/**/shots/

# cargo-fuzz outputs (fuzz/ is its own workspace)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Local Claude Code settings (per-machine; held expired local API JWTs until 2026-10-12)
.claude/settings.local.json

# Legacy runtime GLB import cache (read-only fallback; never tracked — SCEA Duck purged 2026-10-13)
fractalengine/assets/imported/

# iroh 0.35 store fixture — generated by fe-sync/tests/fixtures/p2p_store_v035_gen (CI generates it)
fe-sync/tests/fixtures/p2p_store_v035/
# ...and that generator's own build dir (it is a separate workspace)
fe-sync/tests/fixtures/p2p_store_v035_gen/target/

# scrt mind-palace working memory (agent-local)
.mpg/

# Python bytecode from the QA client modules
/tools/qa/__pycache__/
/tools/qa/**/__pycache__/
# root-only: the register and run dirs live in /qa; tools/qa is tracked source (an unanchored qa/ silently ignored new harness files)
/qa/