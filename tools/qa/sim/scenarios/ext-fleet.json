{
  "name": "ext-fleet",
  "description": "Extension platform fleet journey (spec R35): policy, install, consent and bind a four-mover fleet, run it at 2 Hz for 3 minutes, bus command floors through REST and WS, demote then re-grant the installing editor mid-flight, then publish the revocation list. Holds the observables of R5, R18, R22, R23, R24. Uses the extension driver ops and the extension probe (tools/qa/sim/AGENTS.md section extension).",
  "seed": 20261108,
  "fixture": "basic",
  "verse_name": "QA Basic",
  "assets": "generated",
  "peers": [
    {"name": "owner", "role": "owner"},
    {"name": "editor", "role": "editor"},
    {"name": "viewer", "role": "viewer"}
  ],
  "probe": {"rest_ms": 500, "hierarchy_ms": 2000, "ui_ms": 1000, "query_ms": 5000, "host_ms": 2000},
  "steps": [
    {
      "id": "0", "title": "Preflight: every peer in the shared verse", "settle_s": 15,
      "actions": [
        {"peer": "editor", "via": "gui", "op": "click", "args": {"name": "Close window", "role": "button"}, "optional": true},
        {"peer": "editor", "via": "gui", "op": "click", "args": {"name": "Open verse QA Basic"}, "optional": true},
        {"peer": "viewer", "via": "gui", "op": "click", "args": {"name": "Close window", "role": "button"}, "optional": true},
        {"peer": "viewer", "via": "gui", "op": "click", "args": {"name": "Open verse QA Basic"}, "optional": true}
      ],
      "expect": [
        {"probe": "role", "target": "$fixture.verse_id", "peers": ["owner"], "predicate": "equals", "value": "owner"},
        {"probe": "role", "target": "$fixture.verse_id", "peers": ["editor"], "predicate": "equals", "value": "editor"},
        {"probe": "role", "target": "$fixture.verse_id", "peers": ["viewer"], "predicate": "equals", "value": "viewer"}
      ]
    },
    {
      "id": "1", "title": "Owner sets the verse policy, the editor installs and consents, the fleet binds to the petal", "settle_s": 30, "covers": ["R18", "R22"],
      "note": "Policy mode allow-list names the fleet package id and exact content hash; the row is judged role-at-write on every replica. The viewer must refuse the install (Editor floor).",
      "actions": [
        {"id": "pkg", "peer": "owner", "via": "rest", "op": "request", "args": {"method": "GET", "path": "/api/v1/extensions/catalog/fleet-sim"}},
        {"id": "policy", "peer": "owner", "via": "rest", "op": "set_extension_policy", "args": {"verse_id": "$fixture.verse_id", "mode": "allow-list", "allow": [{"package_id": "org.example.fleet-sim", "content_hash": "$pkg.content_hash"}], "ceilings": {"egress": "none"}}, "needs": ["pkg"]},
        {"id": "viewer_install", "peer": "viewer", "via": "rest", "op": "install_extension", "args": {"package": "fleet-sim", "verse_id": "$fixture.verse_id"}, "expect": "refused", "needs": ["policy"], "sync": "+3"},
        {"id": "inst", "peer": "editor", "via": "rest", "op": "install_extension", "args": {"package": "fleet-sim", "verse_id": "$fixture.verse_id"}, "needs": ["policy"], "sync": "+5", "bind": {"installation": "installation", "content_hash": "content_hash"}},
        {"id": "consent", "peer": "editor", "via": "rest", "op": "consent_extension", "args": {"installation": "$inst.installation", "grants": "manifest"}, "needs": ["inst"]},
        {"id": "bound", "peer": "editor", "via": "rest", "op": "bind_extension", "args": {"installation": "$inst.installation", "petal_id": "$fixture.petal_a_id", "config": {"movers": 4, "hz": 2, "seed": 20261108}}, "needs": ["consent"]}
      ],
      "expect": [
        {"probe": "extension", "target": "$inst.installation", "path": "state", "peers": ["editor"], "predicate": "equals", "value": "active", "within_s": 30, "covers": "R11 status after consent and bind"},
        {"probe": "extension", "target": "list", "path": "count", "peers": ["viewer"], "predicate": "equals", "value": 0, "mode": "always", "hold_s": 10, "covers": "R22 the refused install left no installation on the viewer"}
      ]
    },
    {
      "id": "2", "title": "Four movers at 2 Hz for 3 minutes: one batched commit per tick, transforms agree on every peer", "settle_s": 190, "covers": ["R4", "R5"],
      "note": "Run is bounded by hold_s 180. commits <= ticks_run and four ops per commit are exposed by the extension probe as derived fields commits_within_ticks (bool) and ops_per_commit. The owner host log must hold no 'slow DB command' line for PluginCommit and no 504 (analyze.py reads the host log).",
      "actions": [
        {"id": "start", "peer": "editor", "via": "rest", "op": "extension_command", "args": {"installation": "$inst.installation", "petal_id": "$fixture.petal_a_id", "command": "start", "args": {}}, "sync": "barrier"}
      ],
      "expect": [
        {"probe": "extension", "target": "$inst.installation", "path": "counters.commits_within_ticks", "peers": ["owner"], "predicate": "equals", "value": true, "mode": "always", "hold_s": 180, "after": "start", "covers": "R5 commits <= ticks_run"},
        {"probe": "extension", "target": "$inst.installation", "path": "counters.ops_per_commit", "peers": ["owner"], "predicate": "equals", "value": 4, "within_s": 60, "after": "start"},
        {"probe": "extension", "target": "$inst.installation", "path": "counters.refusals", "peers": ["owner"], "predicate": "equals", "value": {}, "within_s": 60, "after": "start", "covers": "R22 an Editor-floor identity is never refused for authority"},
        {"probe": "transform", "target": "$inst.installation.movers", "path": "position", "predicate": "agree", "peers": "all", "within_s": 90, "covers": "R5 transforms agree on every peer"},
        {"probe": "ui", "target": "view", "path": "notice.text", "peers": ["editor"], "predicate": "excludes", "value": "504", "mode": "always", "hold_s": 180}
      ]
    },
    {
      "id": "3", "title": "Bus command floors: viewer refused, owner admitted, through REST and WS", "settle_s": 30, "covers": ["R10", "R20"],
      "note": "Commands mount petal-scoped (docs/extensions/bus.md section 8). The viewer is below the command role floor on both doors; the owner is above it.",
      "actions": [
        {"id": "viewer_rest", "peer": "viewer", "via": "rest", "op": "extension_command", "args": {"installation": "$inst.installation", "petal_id": "$fixture.petal_a_id", "command": "stop", "args": {}, "door": "rest"}, "expect": "refused"},
        {"id": "viewer_ws", "peer": "viewer", "via": "rest", "op": "extension_command", "args": {"installation": "$inst.installation", "petal_id": "$fixture.petal_a_id", "command": "stop", "args": {}, "door": "ws"}, "expect": "refused"},
        {"id": "owner_ws", "peer": "owner", "via": "rest", "op": "extension_command", "args": {"installation": "$inst.installation", "petal_id": "$fixture.petal_a_id", "command": "start", "args": {}, "door": "ws"}, "sync": "+2"}
      ],
      "expect": [
        {"probe": "extension", "target": "$inst.installation", "path": "counters.commands_refused", "peers": ["owner"], "predicate": "equals", "value": 2, "within_s": 20, "after": "viewer_ws"},
        {"probe": "extension", "target": "$inst.installation", "path": "state", "peers": ["owner"], "predicate": "equals", "value": "active", "within_s": 20, "after": "owner_ws"}
      ]
    },
    {
      "id": "4", "title": "Owner demotes the installing editor mid-flight: the lease is revoked and no fleet row lands; re-grant resumes it", "settle_s": 120, "covers": ["R22", "R23"],
      "note": "Revoke and re-grant use the GUI path proven in p2p-core 13a/13c. While demoted, extension commits are judged as the demoted identity on every replica, so the movers stop moving.",
      "actions": [
        {"peer": "owner", "via": "gui", "op": "click_until", "args": {"click": {"name": "Browse all verses", "exact": true}, "until": "Join a verse from browser", "max": 3}},
        {"peer": "owner", "via": "gui", "op": "click", "args": {"name": "Options for verse QA Basic", "exact": true}},
        {"peer": "owner", "via": "gui", "op": "click", "args": {"name": "Access", "role": "button", "exact": true}},
        {"peer": "owner", "via": "gui", "op": "click", "args": {"name": "Revoke role grant for ${peers.editor.did}", "exact": true}},
        {"id": "demote", "peer": "owner", "via": "gui", "op": "click", "args": {"name": "Confirm Revoke role grant for ${peers.editor.did}", "exact": true, "wait_s": 3}},
        {"id": "editor_demoted", "peer": "editor", "via": "host", "op": "wait_role", "args": {"not_role": "editor", "timeout_s": 90}, "needs": ["demote"]},
        {"id": "hold_demoted", "peer": "owner", "via": "host", "op": "sleep", "args": {"seconds": 20}, "needs": ["editor_demoted"]},
        {"peer": "owner", "via": "gui", "op": "click", "args": {"name": "Role to assign for ${peers.editor.did}", "exact": true}, "needs": ["hold_demoted"]},
        {"peer": "owner", "via": "gui", "op": "click", "args": {"name": "editor", "exact": true}},
        {"id": "regrant", "peer": "owner", "via": "gui", "op": "click", "args": {"name": "Assign role editor to ${peers.editor.did}", "exact": true}},
        {"peer": "owner", "via": "gui", "op": "click", "args": {"name": "Confirm Assign role editor to ${peers.editor.did}", "exact": true, "wait_s": 3}, "optional": true}
      ],
      "expect": [
        {"probe": "extension", "target": "$inst.installation", "path": "state", "peers": ["editor"], "predicate": "not_equals", "value": "active", "within_s": 60, "after": "editor_demoted", "covers": "R22 the demoted identity's instance stops"},
        {"probe": "transform", "target": "$inst.installation.movers", "path": "position", "predicate": "agree", "peers": "all", "within_s": 60, "after": "hold_demoted", "covers": "no divergence while demoted"},
        {"probe": "extension", "target": "$inst.installation", "path": "state", "peers": ["editor"], "predicate": "equals", "value": "active", "within_s": 90, "after": "regrant", "covers": "R22 re-grant resumes the binding"}
      ]
    },
    {
      "id": "5", "title": "Owner publishes the revocation list: instances stop, extension rows are withdrawn, hand edits survive", "settle_s": 120, "covers": ["R23", "R24"],
      "note": "A property the editor sets by hand on a fleet-moved node must survive withdrawal (R24 AC). Readings from the fleet vanish from /api/v1/query.",
      "actions": [
        {"id": "hand_edit", "peer": "editor", "via": "rest", "op": "set_property", "args": {"node_id": "$inst.installation.mover0", "key": "hand_note", "value": "kept"}},
        {"id": "revoke_list", "peer": "owner", "via": "rest", "op": "publish_revocation", "args": {"entries": [{"package_id": "org.example.fleet-sim", "content_hash": "$inst.content_hash"}]}, "needs": ["hand_edit"], "sync": "barrier"},
        {"id": "reinstall", "peer": "editor", "via": "rest", "op": "install_extension", "args": {"package": "fleet-sim", "verse_id": "$fixture.verse_id"}, "expect": "refused", "needs": ["revoke_list"], "sync": "+30"}
      ],
      "expect": [
        {"probe": "extension", "target": "$inst.installation", "path": "state", "peers": "all", "predicate": "equals", "value": "revoked", "within_s": 60, "after": "revoke_list", "covers": "R23 layer d stops running instances"},
        {"probe": "hierarchy", "target": "$fixture.petal_a_id", "path": "extension_created", "peers": "all", "predicate": "count", "value": 0, "within_s": 90, "after": "revoke_list", "covers": "R24 extension-created nodes removed"},
        {"probe": "properties", "target": "$inst.installation.mover0", "path": "hand_note", "peers": "all", "predicate": "equals", "value": "kept", "within_s": 90, "after": "revoke_list", "covers": "R24 hand edit survives"},
        {"probe": "query", "target": "fleet_readings", "path": "rows", "peers": "all", "predicate": "count", "value": 0, "within_s": 90, "after": "revoke_list", "covers": "R24 revoked readings excluded"},
        {"probe": "alive", "target": "all", "predicate": "present", "mode": "always", "hold_s": 10}
      ]
    }
  ]
}
