    },
    {
      "id": "2",
      "title": "PJ5: a ladder entry renders within budget while a 5 MB member is served",
      "settle_s": 90,
      "covers": [
        "PJ5"
      ],
      "actions": [
        {
          "peer": "owner",
          "via": "rest",
          "op": "portal_admit",
          "args": {
            "package_id": "qa.portal.ladder",
            "content_hash": "$up_tier_5mb.content_hash"
          },
          "id": "adm5"
        },
        {
          "peer": "owner",
          "via": "gui",
          "op": "click",
          "args": {
            "name": "Open bundle"
          },
          "id": "open5",
          "needs": [
            "adm5"
          ],
          "note": "accessible name placeholder: T3.1 ux.md fixes the exact Open name"
        }
      ],
      "expect": [
        {
          "probe": "portal",
          "target": "qa.portal.ladder",
          "predicate": "equals",
          "path": "observe.title",
          "peers": [
            "owner"
          ],
          "within_s": 30,
          "after": "open5",
          "value": "QA Docs Site"
        },
        {
          "probe": "portal",
          "target": "qa.portal.ladder",
          "predicate": "count",
          "path": "frame_stall_ms",
          "peers": [
            "owner"
          ],
          "within_s": 30,
          "after": "open5",
          "note": "no host-band frame stall over the threshold",
          "value": 0
        }
      ]
    },
    {
      "id": "3",
      "title": "PJ7: storm bundle opens 64 subscriptions, floods 500 msgs/s for 5 s, bursts 20 writes, then idles 60 s",
      "settle_s": 120,
      "covers": [
        "PJ7",
        "R9",
        "R10"
      ],
      "actions": [
        {
          "peer": "owner",
          "via": "rest",
          "op": "upload_bundle",
          "args": {
            "petal_id": "$pp.id",
            "path": "$assets.portal.storm.path",
            "name": "storm"
          },
          "id": "storm",
          "bind": {
            "content_hash": "data.content_hash",
            "asset_id": "data.id"
          }
        },
        {
          "peer": "owner",
          "via": "rest",
          "op": "create_repository_node",
          "args": {
            "fractal_id": "$pf.id",
            "petal_id": "$pp.id",
            "name": "Storm repo",
            "bundle_asset": "$storm.asset_id",
            "position": [
              0,
              0,
              6
            ]
          },
          "id": "rstorm"
        },
        {
          "peer": "owner",
          "via": "rest",
          "op": "portal_admit",
          "args": {
            "package_id": "qa.portal.storm",
            "content_hash": "$storm.content_hash"
          },
          "id": "adm_storm"
        },
        {
          "peer": "owner",
          "via": "gui",
          "op": "click",
          "args": {
            "name": "Open bundle"
          },
          "id": "open_storm",
          "needs": [
            "adm_storm"
          ],
          "note": "accessible name placeholder: T3.1 ux.md fixes the exact Open name"
        },
        {
          "peer": "owner",
          "via": "rest",
          "op": "portal_slot",
          "args": {
            "slot": 1
          },
          "id": "run_storm",
          "needs": [
            "open_storm"
          ]
        },
        {
          "peer": "owner",
          "via": "host",
          "op": "sleep",
          "args": {
            "seconds": 75
          },
          "id": "storm_wait",
          "needs": [
            "run_storm"
          ]
        }
      ],
      "expect": [
        {
          "probe": "portal",
          "target": "qa.portal.storm",
          "predicate": "equals",
          "path": "ipc.live_subscriptions",
          "peers": [
            "owner"
          ],
          "within_s": 20,
          "after": "run_storm",
          "value": 16
        },
        {
          "probe": "portal",
          "target": "qa.portal.storm",
          "predicate": "count",
          "path": "ipc.too_many_subscriptions",
          "peers": [
            "owner"
          ],
          "within_s": 20,
          "after": "run_storm",
          "value": 48
        },
        {
          "probe": "portal",
          "target": "qa.portal.storm",
          "predicate": "present",
          "path": "ipc.rate_limited",
          "peers": [
            "owner"
          ],
          "within_s": 20,
          "after": "run_storm"
        },
        {
          "probe": "portal",
          "target": "qa.portal.storm",
          "predicate": "equals",
          "path": "writes_accepted",
          "peers": [
            "owner"
          ],
          "within_s": 20,
          "after": "run_storm",
          "note": "at most 7: burst 5 plus the 2/s refill",
          "value": 7
        },
        {
          "probe": "portal",
          "target": "qa.portal.storm",
          "predicate": "equals",
          "path": "peer_log.db_thread_timeouts",
          "peers": [
            "owner"
          ],
          "within_s": 90,
          "after": "storm_wait",
          "value": 0
        },
        {
          "probe": "portal",
          "target": "qa.portal.storm",
          "predicate": "equals",
          "path": "idle_reads.node_readings",
          "peers": [
            "owner"
          ],
          "within_s": 90,
          "after": "storm_wait",
          "value": 0
        },
        {
          "probe": "portal",
          "target": "qa.portal.storm",
          "predicate": "equals",
          "path": "idle_reads.query_per_cadence_max",
          "peers": [
            "owner"
          ],
          "within_s": 90,
          "after": "storm_wait",
          "value": 1
        }
      ]
