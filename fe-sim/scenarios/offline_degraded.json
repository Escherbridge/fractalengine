{
  "name": "sim-offline-degraded",
  "seed": 22,
  "timeseries": { "mode": "sharded", "replication_factor": 1, "bucket_width_ms": 120000 },
  "fleet": {
    "verse_name": "Sim Outage Verse",
    "peers": ["alice", "bob", "carol"],
    "ingest_peer": "alice",
    "anchors": ["tower-a", "tower-b", "tower-c"],
    "sensors": [
      { "anchor": "tower-a", "metric": "temperature_c", "units": "C", "cadence_ms": 60000,
        "model": { "type": "sine", "baseline": 15, "amplitude": 8, "period_ms": 3600000 } },
      { "anchor": "tower-b", "metric": "temperature_c", "units": "C", "cadence_ms": 60000,
        "model": { "type": "weather", "baseline": 18, "amplitude": 6, "diurnal_ms": 86400000,
                   "seed": 42, "jitter": 2.5 } },
      { "anchor": "tower-c", "metric": "temperature_c", "units": "C", "cadence_ms": 60000,
        "model": { "type": "random_walk", "start": 12.5, "step": 0.4, "seed": 7 } }
    ],
    "start_ms": 1750000000000,
    "duration_ms": 600000
  },
  "events": [
    { "kind": "peer_offline", "at_ms": 300000, "peer": "alice" },
    { "kind": "query", "at_ms": 300000, "peer": "bob", "label": "degraded-aggregate",
      "query": { "type": "window_aggregate", "metric": "temperature_c",
                 "start_ms": 0, "end_ms": 660000 },
      "timeout_ms": 3000 },
    { "kind": "peer_online", "at_ms": 450000, "peer": "alice" },
    { "kind": "query", "at_ms": 601000, "peer": "bob", "label": "healed-aggregate",
      "query": { "type": "window_aggregate", "metric": "temperature_c",
                 "start_ms": 0, "end_ms": 660000 },
      "timeout_ms": 5000 },
    { "kind": "query", "at_ms": 601000, "peer": "bob", "label": "healed-readings",
      "query": { "type": "readings_in_window", "metric": "temperature_c",
                 "start_ms": 0, "end_ms": 660000 },
      "timeout_ms": 5000 }
  ]
}
