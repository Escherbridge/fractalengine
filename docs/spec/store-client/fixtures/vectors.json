{
  "contract": "fe-store-client/1",
  "endpoint": "static-endpoint",
  "now": "2026-11-08T00:00:00Z",
  "keys": {
    "index-test-1": "index key pinned for static-endpoint",
    "index-unknown": "index key not pinned",
    "publisher-a": "publisher trust root (trusted_publishers.toml)",
    "operator-publisher": "operator's own publisher trust root",
    "revocation-test-1": "trust root flagged revocation = true",
    "licensee": "ed25519 identity of the licensee",
    "device": "X25519 device key",
    "issuer-test-1": "entitlement issuer key in the IssuerKeyring"
  },
  "vectors": [
    { "id": "SC-01", "op": "discover", "fixture": "api/v1/catalog/config.json", "expect": { "outcome": "ok", "registry_protocol": 1, "search": "local" } },
    { "id": "SC-02", "op": "list", "fixture": "api/v1/catalog/index.json", "expect": { "outcome": "ok", "entries": ["org.example.fleet-sim", "org.example.site-viewer", "org.example.analytics-pack", "org.example.yank-demo", "org.example.revoked-sample"], "skipped_silently": ["org.example.scene-pack"], "refused": [], "stale": false } },
    { "id": "SC-03", "op": "search", "query": { "q": "FLEET" }, "expect": { "outcome": "ok", "items": ["org.example.fleet-sim"] } },
    { "id": "SC-04", "op": "search", "query": { "tag": "readings" }, "expect": { "outcome": "ok", "items": ["org.example.fleet-sim", "org.example.analytics-pack"] } },
    { "id": "SC-05", "op": "search", "query": { "tag": "readings,bi" }, "expect": { "outcome": "ok", "items": ["org.example.analytics-pack"] } },
    { "id": "SC-06", "op": "search", "query": { "tag": "Readings" }, "expect": { "outcome": "ok", "items": [] } },
    { "id": "SC-07", "op": "search", "query": { "kind": "web-bundle" }, "expect": { "outcome": "ok", "items": ["org.example.site-viewer"] } },
    { "id": "SC-08", "op": "search", "query": { "sort": "name" }, "expect": { "outcome": "ok", "items": ["org.example.analytics-pack", "org.example.fleet-sim", "org.example.revoked-sample", "org.example.site-viewer", "org.example.yank-demo"] } },
    { "id": "SC-09", "op": "detail", "package": "org.example.fleet-sim", "expect": { "outcome": "ok", "versions": ["1.1.0", "1.0.0"] } },
    { "id": "SC-10", "op": "verify", "package": "org.example.fleet-sim", "version": "1.1.0", "expect": { "outcome": "ok", "header": "plugin/extension.json" } },
    { "id": "SC-11", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "expect": { "outcome": "installed" } },
    { "id": "SC-12", "op": "install", "package": "org.example.site-viewer", "version": "1.0.0", "expect": { "outcome": "installed", "kind": "web-bundle" } },
    { "id": "SC-13", "op": "list", "fixture": "api/v1/catalog/index.json", "expect": { "outcome": "ok", "latest": { "org.example.yank-demo": "1.0.0" } } },
    { "id": "SC-14", "op": "install", "package": "org.example.yank-demo", "version": "2.0.0", "expect": { "outcome": "refused", "refusal": "Yanked" } },
    { "id": "SC-15", "op": "install", "package": "org.example.yank-demo", "version": "1.0.0", "expect": { "outcome": "installed" } },
    { "id": "SC-16", "op": "install", "package": "org.example.revoked-sample", "version": "1.0.0", "note": "kill list names this content_hash under org.example.renamed-copy", "expect": { "outcome": "refused", "refusal": "revoked" } },
    { "id": "SC-17", "op": "detail", "package": "org.example.analytics-pack", "expect": { "outcome": "ok", "access": "licensed", "acquire": "not offered" } },
    { "id": "SC-18", "op": "acquire", "fixture": "documents/hosted-licensed-detail.json", "expect": { "outcome": "ok", "opens": "https://registry.example.test/acquire/org.example.analytics-pack?licensee_did={{did:licensee}}&device_x25519_did={{x25519_did:device}}", "params": "percent-encoded", "browser": "system" } },
    { "id": "SC-19", "op": "entitlement-check", "fixture": "documents/token-request.json", "expect": { "outcome": "ok", "proof": "valid", "token": "documents/token-response.json", "token_content_hash": "{{content_hash:org.example.analytics-pack@1.0.0}}" } },
    { "id": "SC-20", "op": "parse-errors", "fixture": "documents/errors.json", "expect": { "outcome": "ok", "codes": ["invalid_request", "proof_invalid", "not_entitled", "reissue_refused", "device_limit_reached", "unknown_package", "rate_limited"] } },
    { "id": "SC-21", "op": "discover", "fixture": "documents/hosted-config.json", "expect": { "outcome": "ok", "search": "server", "entitlements": "offered" } },
    { "id": "SC-22", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "add", "path": "/entries/0/future_member", "value": { "any": "shape" } }], "resign": true }], "expect": { "outcome": "ok", "note": "unknown members stay covered by the signature and are ignored" } },

    { "id": "SC-N01", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "replace", "path": "/entries/0/name", "value": "Renamed" }], "resign": false }], "expect": { "outcome": "refused", "refusal": "IndexSignature" } },
    { "id": "SC-N02", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [], "resign": "index-unknown" }], "expect": { "outcome": "refused", "refusal": "IndexSignerUnknown" } },
    { "id": "SC-N03", "op": "list", "pin": { "index-test-1": "publisher-a" }, "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [], "resign": "publisher-a" }], "expect": { "outcome": "refused", "refusal": "IndexKeyMisused" } },
    { "id": "SC-N04", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "replace", "path": "/schema_version", "value": 2 }], "resign": true }], "expect": { "outcome": "refused", "refusal": "IndexSchema" } },
    { "id": "SC-N05", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "add", "path": "/entries/0/weight", "value": 1.5 }], "resign": "raw" }], "expect": { "outcome": "refused", "refusal": "IndexMalformed" } },
    { "id": "SC-N06", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "copy", "from": "/entries/0", "path": "/entries/-" }, { "op": "replace", "path": "/entries/5/package_id", "value": "Org.Example.Fleet-Sim" }], "resign": true }], "expect": { "outcome": "ok", "refused": ["Org.Example.Fleet-Sim"] } },
    { "id": "SC-N07", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "replace", "path": "/entries/0/package_id", "value": "org.example.fleet-sim.JSON" }], "resign": true }], "expect": { "outcome": "ok", "refused": ["org.example.fleet-sim.JSON"] } },
    { "id": "SC-N08", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "replace", "path": "/entries/0/latest_version", "value": "1.1.0+build.7" }], "resign": true }], "expect": { "outcome": "ok", "refused": ["org.example.fleet-sim"] } },
    { "id": "SC-N09", "op": "detail", "package": "org.example.fleet-sim", "mutate": [{ "file": "api/v1/catalog/packages/org.example.fleet-sim.json", "patch": [{ "op": "replace", "path": "/description", "value": "changed after signing" }], "rehash": false }], "expect": { "outcome": "refused", "refusal": "DetailMismatch" } },
    { "id": "SC-N10", "op": "detail", "package": "org.example.fleet-sim", "mutate": [{ "file": "api/v1/catalog/packages/org.example.fleet-sim.json", "patch": [{ "op": "replace", "path": "/kind", "value": "web-bundle" }], "rehash": true, "resign": true }], "expect": { "outcome": "refused", "refusal": "DetailMismatch" } },
    { "id": "SC-N11", "op": "list", "cache": { "issued_at": "2026-11-08T00:00:00Z" }, "expect": { "outcome": "ok", "from_cache": true, "note": "live index (2026-11-07) is older than the cached one and is ignored" } },
    { "id": "SC-N12", "op": "install", "now": "2026-11-15T00:00:00Z", "package": "org.example.fleet-sim", "version": "1.1.0", "expect": { "outcome": "installed", "stale": true } },
    { "id": "SC-N13", "op": "discover", "mutate": [{ "file": "api/v1/catalog/config.json", "patch": [{ "op": "replace", "path": "/registry_protocol", "value": 2 }] }], "expect": { "outcome": "refused", "refusal": "ProtocolMismatch" } },
    { "id": "SC-N14", "op": "discover", "mutate": [{ "file": "api/v1/catalog/config.json", "patch": [{ "op": "replace", "path": "/index_key_id", "value": "index-unknown" }] }], "then": "list signed by index-unknown", "expect": { "outcome": "refused", "refusal": "IndexSignerUnknown", "note": "config.json never widens the pin" } },
    { "id": "SC-N15", "op": "verify", "package": "org.example.fleet-sim", "version": "1.1.0", "mutate": [{ "file": "api/v1/catalog/packages/org.example.fleet-sim/1.1.0/attestation.json", "patch": [{ "op": "replace", "path": "/manifest_b64", "value": "{{manifest_b64:org.example.fleet-sim@1.0.0}}" }] }], "expect": { "outcome": "refused", "refusal": "PackageInvalid" } },
    { "id": "SC-N16", "op": "verify", "package": "org.example.fleet-sim", "version": "1.1.0", "mutate": [{ "file": "api/v1/catalog/packages/org.example.fleet-sim/1.1.0/attestation.json", "patch": [{ "op": "remove", "path": "/header_members_b64/members.json" }] }], "expect": { "outcome": "refused", "refusal": "PackageInvalid" } },
    { "id": "SC-N17", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "mutate": [{ "file": "api/v1/catalog/packages/org.example.fleet-sim/1.1.0/attestation.json", "delete": true }], "expect": { "outcome": "installed", "header": "HeaderUnavailable", "consent": "after download" } },
    { "id": "SC-N18", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "blob": "archive one byte longer than size_bytes", "expect": { "outcome": "refused", "refusal": "TooLarge" } },
    { "id": "SC-N19", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "blob": "the org.example.fleet-sim@1.0.0 archive served at the 1.1.0 download_url", "expect": { "outcome": "refused", "refusal": "ContentHashMismatch" } },
    { "id": "SC-N20", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "mutate": [{ "file": "api/v1/catalog/packages/org.example.fleet-sim.json", "patch": [{ "op": "replace", "path": "/versions/0/download_url", "value": "../../../../../outside.hexon" }], "rehash": true, "resign": true }], "expect": { "outcome": "refused", "refusal": "DetailMismatch", "note": "resolves outside {base}" } },
    { "id": "SC-N21", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "mutate": [{ "file": "api/v1/catalog/packages/org.example.fleet-sim.json", "patch": [{ "op": "replace", "path": "/versions/0/download_url", "value": "file:///C:/outside.hexon" }], "rehash": true, "resign": true }], "expect": { "outcome": "refused", "refusal": "DetailMismatch" } },
    { "id": "SC-N22", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "replace", "path": "/entries/0/publisher/did", "value": "{{did:operator-publisher}}" }], "resign": true }], "expect": { "outcome": "refused", "refusal": null, "note": "listing publisher.did differs from the manifest publisher_did" } },
    { "id": "SC-N23", "op": "install", "package": "org.example.site-viewer", "version": "1.0.0", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [{ "op": "replace", "path": "/entries/1/kind", "value": "extension" }], "resign": true }, { "file": "api/v1/catalog/packages/org.example.site-viewer.json", "patch": [{ "op": "replace", "path": "/kind", "value": "extension" }], "rehash": true }], "expect": { "outcome": "refused", "refusal": null, "note": "verified manifest kind web-bundle disagrees with the listing" } },
    { "id": "SC-N24", "op": "kill-list", "cache": { "revocations_issued_at": "2026-11-08T00:00:00Z", "revoked": ["{{content_hash:org.example.revoked-sample@1.0.0}}"] }, "mutate": [{ "file": "api/v1/catalog/revocations.json", "patch": [{ "op": "replace", "path": "/entries", "value": [] }, { "op": "replace", "path": "/issued_at", "value": "2026-11-06T00:00:00Z" }], "resign": "revocation-test-1" }], "expect": { "outcome": "ok", "revoked_still": ["{{content_hash:org.example.revoked-sample@1.0.0}}"], "note": "an older list never replaces the cached one" } },
    { "id": "SC-N25", "op": "kill-list", "unreachable": true, "cache": { "revoked": ["{{content_hash:org.example.revoked-sample@1.0.0}}"] }, "expect": { "outcome": "ok", "revoked_still": ["{{content_hash:org.example.revoked-sample@1.0.0}}"] } },
    { "id": "SC-N26", "op": "kill-list", "mutate": [{ "file": "api/v1/catalog/revocations.json", "patch": [], "resign": "index-test-1" }], "expect": { "outcome": "refused", "note": "an index key is never a kill-list signer" } },
    { "id": "SC-N27", "op": "kill-list", "mutate": [{ "file": "api/v1/catalog/revocations.json", "patch": [{ "op": "replace", "path": "/entries/0/content_hash", "value": "{{component_digest:org.example.fleet-sim@1.1.0}}" }], "resign": "revocation-test-1" }], "then": "install org.example.fleet-sim 1.1.0", "expect": { "outcome": "refused", "refusal": "revoked", "note": "an entry naming the component digest revokes too" } },
    { "id": "SC-N28", "op": "list", "endpoint_change": "every version of org.example.fleet-sim yanked; entry removed from index.json", "installed": ["org.example.fleet-sim@1.1.0"], "expect": { "outcome": "ok", "installed_keeps_working": true, "note": "leaving the index is not revocation" } },
    { "id": "SC-N29", "op": "search", "hosted": true, "server_hit": "org.example.not-in-index", "expect": { "outcome": "ok", "actions": [], "note": "a search hit without a verified index entry shows no badge, acquire link or install" } },
    { "id": "SC-N30", "op": "entitlement-check", "mutate": [{ "file": "documents/token-request.json", "patch": [{ "op": "replace", "path": "/iat", "value": 1762473000 }], "resign": false }], "expect": { "outcome": "refused", "status": 401, "error": "proof_invalid" } },
    { "id": "SC-N31", "op": "entitlement-check", "proof_domain": "none (signature over the canonical fields without the domain line)", "expect": { "outcome": "refused", "status": 401, "error": "proof_invalid" } },
    { "id": "SC-N32", "op": "any", "assert": "no request to {base} or to any URL a document names carries Authorization, Cookie or a client certificate, redirects included", "expect": { "outcome": "ok" } },
    { "id": "SC-N33", "op": "install", "package": "org.example.fleet-sim", "version": "1.1.0", "assert": "download_url ../../../../blobs/<hash>.hexon resolves against the detail document to {base}/blobs/<hash>.hexon", "expect": { "outcome": "installed" } },
    { "id": "SC-N34", "op": "list", "mutate": [{ "file": "api/v1/catalog/index.json", "patch": [], "resign": "index-test-1", "signature_encoding": "base64" }], "expect": { "outcome": "ok", "note": "hex and standard base64 signatures both verify" } }
  ]
}
